# Copy to .env and fill in. Never commit .env.

# HTTP listen port.
PORT=8080

# Phase 1 only: JSON file with sites and experiments, used when DATABASE_URL is empty.
CONFIG_FILE=internal/configcache/testdata/config.sample.json

# PostgreSQL connection string (Neon or local docker-compose).
DATABASE_URL=postgres://user:password@localhost:5432/variants?sslmode=disable

# Bearer key for /v1/platform/* (create sites, rotate keys). Generate with: openssl rand -hex 32
PLATFORM_ADMIN_KEY=replace-me

# LLM provider key, read only by the server, never sent to browsers.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# How often replicas reload configuration into the in-memory snapshot.
CONFIG_REFRESH_INTERVAL=10s

# Public base URL of this service (used for the demo site's origin allow-list).
PUBLIC_BASE_URL=http://localhost:8080
# Host the snippet fetches payloads from; defaults to PUBLIC_BASE_URL when empty.
CDN_BASE_URL=

# Enables the demo site and the /v1/admin/simulate endpoint. Never true in production.
DEMO_MODE=true

# debug | info | warn | error
LOG_LEVEL=info
